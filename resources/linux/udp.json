{
  "debug": false,
  "write": false,
  "interface": "udp://255.255.255.255:9999",
  "flags": 0,
  "key": "",
  "hmac": "",
  "encryption": "none",
  "logging": {
    "console-enable": true,
    "console-level": "info",
